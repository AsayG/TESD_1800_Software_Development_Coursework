package multimedia;
import javafx.scene.paint.Color;
import java.io.File;
import javafx.application.Application;
import javafx.css.Declaration;
import javafx.event.ActionEvent;
import javafx.event.EventHandler;
import javafx.geometry.Insets;
import javafx.geometry.Orientation;
import javafx.scene.Group;
import javafx.scene.Scene;
import javafx.scene.control.Button;
import javafx.scene.control.Label;
import javafx.scene.control.MenuButton;
import javafx.scene.control.RadioButton;
import javafx.scene.control.RadioMenuItem;
import javafx.scene.control.ScrollBar;
import javafx.scene.control.ScrollPane;
import javafx.scene.control.ScrollPane.ScrollBarPolicy;
import javafx.scene.control.Slider;
import javafx.scene.control.ToggleGroup;
import javafx.scene.layout.Background;
import javafx.scene.layout.BackgroundFill;
import javafx.scene.layout.BorderPane;
import javafx.scene.layout.CornerRadii;
import javafx.scene.layout.HBox;
import javafx.scene.layout.Priority;
import javafx.scene.layout.VBox;
import javafx.scene.media.Media;
import javafx.scene.media.MediaPlayer;
import javafx.scene.media.MediaView;
import javafx.scene.paint.Paint;
import javafx.scene.shape.Rectangle;
import javafx.stage.FileChooser;
import javafx.stage.Stage;
import javafx.util.Duration;
	public class Multimedia extends Application {
		MediaView mediaview = new MediaView();
		BorderPane root = new BorderPane();
	   
		Slider slider = new Slider();
		
		ScrollPane scrollPane = new ScrollPane();
		
		private boolean isFastForwarding = false;
		
		Button btn1 = new Button(">");
		Button btn2 = new Button(">>");
		Button rewindButton = new Button("<<");
		Button openFile = new Button("Open File");
		VBox radioButtons = new VBox(20);
		
		HBox hbox = new HBox(rewindButton, btn1, btn2);
		FileChooser.ExtensionFilter ex1 = new FileChooser.ExtensionFilter("MP4 Files", "*.mp4");
		FileChooser.ExtensionFilter ex2 = new FileChooser.ExtensionFilter("MP3 Files", "*.mp3");
		
		@Override
		public void start(Stage primaryStage) throws Exception {
			
			
			
			openFile.setOnAction(new EventHandler<ActionEvent>() {
				@Override
				public void handle(ActionEvent argo) {
					FileChooser fileChooser = new FileChooser();
					fileChooser.setTitle("Save My File");
					fileChooser.setInitialDirectory(new File("C:\\Users\\student\\Videos"));
					fileChooser.getExtensionFilters().addAll(ex1, ex2);
					
					File selectedFile = fileChooser.showOpenDialog(primaryStage);
					if (selectedFile != null) {
						System.out.println("open File");
						System.out.println(selectedFile.getPath());
						String fileUrl = selectedFile.toURI().toString();
						
						
						Media media = new Media(fileUrl);
						MediaPlayer mediaPlayer = new MediaPlayer(media);
						mediaview.setMediaPlayer(mediaPlayer);
						mediaPlayer.setAutoPlay(true);
						
						if (mediaPlayer != null) {
							mediaPlayer.stop();
						}
						
						btn1.setOnAction(e ->{
							if (btn1.getText().equals(">")) {
								mediaPlayer.play();
								btn1.setText("||");
							}else {
								mediaPlayer.pause();
								btn1.setText(">");
							}
							
							
						}); 
					
						rewindButton.setOnAction(e -> {
							Duration currentTime = mediaPlayer.getCurrentTime();
							Duration newTime = currentTime.subtract(Duration.seconds(10));
							
							if (newTime.lessThan(Duration.ZERO)) {
								newTime = Duration.ZERO;
							}
							mediaPlayer.seek(newTime);
							
						});
						
						btn2.setOnAction(e->{
							if (!isFastForwarding) {
								mediaPlayer.setRate(2.0);
								btn2.setText(">> 2x");
								isFastForwarding = true;
							} else {
								mediaPlayer.setRate(1.0);
								btn2.setText(">>");
								isFastForwarding = false;
							}
							
						});
					
						mediaPlayer.currentTimeProperty().addListener((observable, oldTime, newTime) -> {
							
							if (!slider.isValueChanging()) {
								slider.setValue(newTime.toMillis());
							}
						});
						slider.valueProperty().addListener(observable -> {
							if (slider.isValueChanging()) {
								mediaPlayer.seek(Duration.millis(slider.getValue()));
							}
						});
						mediaPlayer.setOnReady(() -> {
							double duration = mediaPlayer.getTotalDuration().toMillis();
							slider.setMax(duration);
						});
						
						
					}
				
				}
			
			});
			
			
			
			
			MenuButton dropdown = new MenuButton("Change Color");
			
			ToggleGroup group = new ToggleGroup();
			
			RadioMenuItem rbRed = new RadioMenuItem("RED");
			RadioMenuItem rbBlue = new RadioMenuItem("Navy BLUE");
			RadioMenuItem rbGreen = new RadioMenuItem("GREEN");
			RadioMenuItem rbYellow = new RadioMenuItem("YELLOW");
			RadioMenuItem rbBlack = new RadioMenuItem("BLACK");
			
			rbRed.setToggleGroup(group);
			rbBlue.setToggleGroup(group);
			rbGreen.setToggleGroup(group);
			rbYellow.setToggleGroup(group);
			rbBlack.setToggleGroup(group);
			
			rbRed.setOnAction(e -> changeBackground(root, Color.RED));
			rbBlue.setOnAction(e -> changeBackground(root, Color.NAVY));
			rbGreen.setOnAction(e -> changeBackground(root, Color.GREEN));
			rbYellow.setOnAction(e -> changeBackground(root, Color.YELLOW));
			rbBlack.setOnAction(e -> changeBackground(root, Color.BLACK));
			
			dropdown.getItems().addAll(rbRed, rbBlue, rbGreen, rbYellow, rbBlack);
			
			HBox topControls = new HBox(10);
			topControls.getChildren().addAll(openFile, slider, dropdown);
			topControls.setStyle("-fx-padding: 5px; -fx-spacing: 5px;");
			topControls.setPadding(new Insets(10));
			root.setTop(topControls);
			
			HBox.setHgrow(slider, Priority.ALWAYS);
			
			hbox.setStyle("-fx-alignment: center; -fx-spacing: 10px; -fx-padding: 5px;");
			root.setBottom(hbox);
			
			root.setTop(topControls);
			
			//root.setTop(openFile);
			
			root.setCenter(mediaview);
			
			
			mediaview.setPreserveRatio(true);
			
			scrollPane.setVbarPolicy(ScrollPane.ScrollBarPolicy.AS_NEEDED);
			scrollPane.setHbarPolicy(ScrollPane.ScrollBarPolicy.NEVER);
			scrollPane.setFitToWidth(true);
			
			scrollPane.setContent(root);
			
			Scene scene = new Scene(scrollPane, 800, 500);
			primaryStage.setTitle("Media Player");
			primaryStage.setScene(scene);
			primaryStage.show();
			
			mediaview.fitWidthProperty().bind(scene.widthProperty());
			mediaview.fitHeightProperty().bind(scene.heightProperty());
			
			
		}
		private void changeBackground(BorderPane root, Object color) {
			BackgroundFill fill = new BackgroundFill((Paint) color, CornerRadii.EMPTY, Insets.EMPTY);
			root.setBackground(new Background(fill));
			
		}
		
	}
	


