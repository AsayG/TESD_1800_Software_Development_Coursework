package exercise17_03;
import java.io.*;

public class Exercise17_03 {

	static File file = new File("Exercise17_03.dat");
	
	public static void main(String[] args) {
		int sum = sumInt(file);
		System.out.println("Total sum of integers: " + sum);
		try(
			DataOutputStream dos = new DataOutputStream(new FileOutputStream(file, true));
				){
			
			for (int i = 0; i < 100; i++) {
				dos.writeInt((int)(Math.random() * 10000));
			}
			
		} catch (IOException e) {
			// TODO Auto-generated catch block
			e.printStackTrace();
		}
	}
	
		public static int sumInt(File file) {
			
			int sum = 0;
			try (DataInputStream dis = new DataInputStream(new FileInputStream(file))){
				
				while (dis.available() > 0) {
					sum += dis.readInt();
				}
	
			} catch (EOFException ex) {
				// TODO Auto-generated catch block
				ex.printStackTrace();
			} catch (IOException ex) {
				// TODO Auto-generated catch block
				ex.printStackTrace();
			} 
			
			
		return sum;
	}

}
