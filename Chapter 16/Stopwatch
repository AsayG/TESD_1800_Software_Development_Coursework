package stopWatch;
import javafx.application.Application;
import javafx.stage.Stage;
import javafx.scene.Scene;
import javafx.scene.layout.VBox;
import javafx.scene.control.Label;
import javafx.scene.control.TextField;
import javafx.scene.control.TextFormatter;
import javafx.util.Duration;
import javafx.scene.media.AudioClip;
import javafx.geometry.Pos;
import javafx.scene.text.Font;
import javafx.animation.Timeline;
import java.io.File;
import java.util.function.UnaryOperator;
import javafx.animation.KeyFrame;

public class StopWatch extends Application {
	AudioClip alarmClip;
	private Timeline timeline;
	private int remainingSeconds;
	TextField txtInput = new TextField();
	public void start(Stage primaryStage) throws Exception {
	
	txtInput.setOnAction(e -> startStopwatch(txtInput));
		
	//String audioPath = new File("https://liveexample.pearsoncmg.com/common/audio/anthem/anthem0.mp3").toURI().toString();
	String audioPath = new File("anthem0.mp3").toURI().toString();
	alarmClip = new AudioClip(audioPath);
	alarmClip.setCycleCount(AudioClip.INDEFINITE);
	
		VBox pane = new VBox(20, new Label("Enter Seconds:"), txtInput);
		pane.setAlignment(Pos.CENTER);
		Scene scene = new Scene(pane, 450, 300);
	    primaryStage.setTitle("Stopwatch 16-21"); // Set the stage title
	    primaryStage.setScene(scene); // Place the scene in the stage
	    primaryStage.show(); // Display the stage
	
}
	UnaryOperator<TextFormatter.Change> filter = change -> {
		String text = change.getControlNewText();
		if (text.matches("\\d*")) {
			return change;
		}
		return null;
	};
	
	public void startStopwatch(TextField displayField) {
		
		remainingSeconds = Integer.parseInt(displayField.getText());
		
		timeline = new Timeline(new KeyFrame(Duration.seconds(1), e ->{
			remainingSeconds--;
			displayField.setText(String.valueOf(remainingSeconds));
			
			if (remainingSeconds<= 0) {
				timeline.stop();
				if (alarmClip != null) {alarmClip.play();}
			}
			
		}));
		
		timeline.setCycleCount(Timeline.INDEFINITE);
		timeline.play();
	}
	
}
